function MineTools.chestTool(id)
	for _, t in ipairs(MineTools.CHEST_TOOLS) do
		if t.id == id then
			return t
		end
	end
	-- Battle Pass signature tools reuse the forever-tool inventory path.
	local pass = MineTools.passTool(id)
	if pass then
