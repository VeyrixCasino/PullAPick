-- Coin / depth ladder tools have no authored rarity — map rung → card ladder colour.
function MineTools.rarityForTier(tier, maxTier)
	maxTier = math.max(1, math.floor(tonumber(maxTier) or #LADDER_RARITY))
	tier = math.clamp(math.floor(tonumber(tier) or 1), 1, maxTier)
	local idx = math.clamp(math.ceil((tier / maxTier) * #LADDER_RARITY), 1, #LADDER_RARITY)
	return LADDER_RARITY[idx]
end

-- Shop ladder: stamp rarity from tier (Common+ allowed).
for _, ladder in pairs(MineTools.TOOLS) do
	local maxTier = #ladder
	for _, row in ipairs(ladder) do
		local rar = row.rarity or MineTools.rarityForTier(row.tier, maxTier)
		row.rarity = rar
		row.rarityId = rar
	end
end

function MineTools.rarityForPower(power)
	power = math.max(0, tonumber(power) or 0)
	if power <= 20 then return "Common" end
	if power <= 80 then return "Uncommon" end
	if power <= 400 then return "Rare" end
	if power <= 2000 then return "Epic" end
	if power <= 20000 then return "Legendary" end
	if power <= 200000 then return "Mythic" end
	if power <= 2e6 then return "Divine" end
	return "Exotic"
end

function MineTools.iconKey(tool)
	if type(tool) == "string" then
