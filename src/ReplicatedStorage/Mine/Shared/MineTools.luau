	return MineTools.protoDefFromId(id)
end

-- Same 4% as cards. Fraction, not percent.
MineTools.SHINY_CHANCE = 0.04
MineTools.SHADOW_OF_SHINY = 1 / 20
MineTools.NIGHTMARE_OF_SHADOW = 1 / 20
MineTools.NIGHTMARE_MAX_LAYER = 2500
MineTools.BUNDLE_DROP = 1 / 5000
MineTools.BUNDLE_TOOL = 1 / 25

function MineTools.rollShiny(rng)
	rng = rng or Random.new()
	return rng:NextNumber() < (MineTools.SHINY_CHANCE or 0.04)
end

--[[
	A tool's finish in one roll. Returns shiny, shadow, nightmare.
	Nightmare replaces shadow, and only rolls when layer < 2500.
]]
function MineTools.rollFinish(rng, layer)
	rng = rng or Random.new()
	if rng:NextNumber() >= (MineTools.SHINY_CHANCE or 0.04) then
		return false, false, false
	end
	if rng:NextNumber() >= (MineTools.SHADOW_OF_SHINY or 0.05) then
		return true, false, false
	end
	local under = tonumber(layer) and tonumber(layer) < (MineTools.NIGHTMARE_MAX_LAYER or 2500)
	if under and rng:NextNumber() < (MineTools.NIGHTMARE_OF_SHADOW or 0.05) then
		return false, false, true
	end
	return false, true, false
end

function MineTools.oneInOf(drop, shiny, shadow, nightmare)
	local p = math.max(1e-18, tonumber(drop) or 0)
	local shinyP = MineTools.SHINY_CHANCE or 0.04
	local shadowP = MineTools.SHADOW_OF_SHINY or 0.05
	local nightP = MineTools.NIGHTMARE_OF_SHADOW or 0.05
	if nightmare then
		p = p * shinyP * shadowP * nightP
	elseif shadow then
		p = p * shinyP * shadowP
	elseif shiny then
		p = p * shinyP
	end
	return math.max(1, math.floor((1 / p) + 0.5))
end

function MineTools.dashOdds(n)
	local s = tostring(math.max(1, math.floor(tonumber(n) or 1)))
	return (s:gsub(".", "%1-"):gsub("-%$", ""))
end

function MineTools.roman(n)
	n = math.max(1, math.floor(tonumber(n) or 1))
	local map = {
		{ 100, "c" }, { 90, "xc" }, { 50, "l" }, { 40, "xl" },
		{ 10, "x" }, { 9, "ix" }, { 5, "v" }, { 4, "iv" }, { 1, "i" },
	}
	local s = ""
	for _, row in ipairs(map) do
		while n >= row[1] do
			s ..= row[2]
			n -= row[1]
		end
	end
	return s
end

MineTools.BAG_DROP = 1 / 2500

function MineTools.protoId(n, kind)
	n = math.max(1, math.floor(tonumber(n) or 1))
	kind = kind or "pick"
	if kind == "pick" then
		return "proto_" .. tostring(n)
	end
	return "proto_" .. kind .. "_" .. tostring(n)
end

function MineTools.protoName(n, kind)
	kind = kind or "pick"
	local r = MineTools.roman(n)
	if kind == "bag" then
		return "b." .. r
	elseif kind == "expl" then
		return "e." .. r
	elseif kind == "drill" then
		return "d." .. r
	end
	return "p." .. r
end

function MineTools.protoParse(id)
	id = tostring(id or "")
	local kind, n = string.match(id, "^proto_(bag|expl|drill)_(%d+)$")
	if kind then
		return tonumber(n), kind
	end
	n = string.match(id, "^proto_(%d+)$")
	if n then
		return tonumber(n), "pick"
	end
	return nil
end

function MineTools.protoIndexFromId(id)
	local n = MineTools.protoParse(id)
	return n
end

function MineTools.protoKindFromPack(pk)
	if type(pk) == "string" then
		pk = { packId = pk }
	end
	pk = pk or {}
	if type(pk.protoKind) == "string" and pk.protoKind ~= "" then
		return pk.protoKind
	end
	local id = tostring(pk.packId or "")
	if string.sub(id, 1, 17) == "proto_bag_bundle_" then
		return "bag"
	end
	if string.sub(id, 1, 18) == "proto_expl_bundle_" then
		return "expl"
	end
	if string.sub(id, 1, 19) == "proto_drill_bundle_" then
		return "drill"
	end
	if pk.kind == "prototype" or string.sub(id, 1, 13) == "proto_bundle_" then
		return "pick"
	end
	return nil
end

function MineTools.protoBundleMeta(kind)
	kind = kind or "pick"
	if kind == "bag" then
		return "proto_bag_bundle_", MineTools.BAG_DROP or (1 / 2500), "A sealed haul crate. Way too much room in here."
	end
	if kind == "expl" then
		return "proto_expl_bundle_", MineTools.BUNDLE_DROP or (1 / 5000), "A sealed charge crate. Long throw, tight boom."
	end
	if kind == "drill" then
		return "proto_drill_bundle_", MineTools.BUNDLE_DROP or (1 / 5000), "A sealed bit crate. Spins like a crime."
	end
	return "proto_bundle_", MineTools.BUNDLE_DROP or (1 / 5000), "A sealed prototype crate. Something in here is illegal."
end

