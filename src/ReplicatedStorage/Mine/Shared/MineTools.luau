-- Eight-tier rarity on found/chest tools (same ladder as cards / loot packs).
-- Derived from drop rate so new entries get a label without hand-authoring.
local LADDER_RARITY = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Divine", "Exotic" }
MineTools.LADDER_RARITY = LADDER_RARITY
MineTools.TOOL_RARITY_ORDER = LADDER_RARITY
-- Forever chest tools never roll below Rare. Common/Uncommon = shop ladder only.
MineTools.CHEST_RARITY_FLOOR = "Rare"
MineTools.TOOL_RARITY_FIND = {
	Rare = 0.006,
	Epic = 0.002,
	Legendary = 0.0006,
	Mythic = 0.00018,
	Divine = 0.00005,
	Exotic = 0.000012,
}
MineTools.TOOL_RARITY_DEF = {
	Common = { label = "Common", blurb = "Shop floor kit. Gets dirt moving." },
	Uncommon = { label = "Uncommon", blurb = "A step up from the bargain bin." },
	Rare = { label = "Rare", blurb = "Chest steel. The floor for forever tools." },
	Epic = { label = "Epic", blurb = "Cuts a band like it owes you money." },
	Legendary = { label = "Legendary", blurb = "Named in the shaft. Hard to forget." },
	Mythic = { label = "Mythic", blurb = "Stories dig themselves around this one." },
	Divine = { label = "Divine", blurb = "Almost unfair. The rock knows it." },
	Exotic = { label = "Exotic", blurb = "Reality bent into a handle. Almost nothing finds this." },
}

local RARITY_RANK = {}
for i, r in ipairs(LADDER_RARITY) do
	RARITY_RANK[r] = i
end
MineTools.RARITY_RANK = RARITY_RANK

function MineTools.normalizeToolRarity(rarity)
	if rarity == nil then return nil end
	local s = tostring(rarity)
	if RARITY_RANK[s] then return s end
	local lower = string.lower(s)
	if lower == "rare" then return "Rare" end
	if lower == "extreme" or lower == "epic" then return "Epic" end
	return MineTools.CHEST_RARITY_FLOOR
end

function MineTools.findChance(rarity)
	rarity = MineTools.normalizeToolRarity(rarity)
	return (rarity and MineTools.TOOL_RARITY_FIND[rarity]) or 0
end

function MineTools.rarityDef(rarity)
	rarity = MineTools.normalizeToolRarity(rarity) or "Common"
	return MineTools.TOOL_RARITY_DEF[rarity] or MineTools.TOOL_RARITY_DEF.Common
end

-- Roll one rarity for a chest forever-tool (or nil = no tool). Floor = Rare.
function MineTools.rollChestRarity(rng, luck)
	rng = rng or Random.new()
	luck = math.max(0, tonumber(luck) or 1)
	local roll = rng:NextNumber()
	local acc = 0
	local floorRank = RARITY_RANK[MineTools.CHEST_RARITY_FLOOR] or 3
	for _, rarity in ipairs(LADDER_RARITY) do
		if (RARITY_RANK[rarity] or 0) >= floorRank then
			acc += (MineTools.TOOL_RARITY_FIND[rarity] or 0) * luck
			if roll < acc then
				return rarity
			end
		end
	end
	return nil
end

function MineTools.toolsOfRarity(list, rarity)
	rarity = MineTools.normalizeToolRarity(rarity)
	local out = {}
	for _, t in ipairs(list or {}) do
		if t and MineTools.normalizeToolRarity(t.rarity or t.rarityId) == rarity then
			table.insert(out, t)
		end
	end
	return out
end

-- Rarity label for found/chest tools. Prefer explicit t.rarity; drop is display-only now.
local function chestRarityFromDrop(d)
	d = tonumber(d) or 0
	-- Match closest FIND rung (Rare floor for forever tools).
	local best, bestDist = "Rare", math.huge
	for rarity, p in pairs(MineTools.TOOL_RARITY_FIND) do
		local dist = math.abs(p - d)
		if dist < bestDist then
			best, bestDist = rarity, dist
		end
	end
	return best
end
MineTools.chestRarityFromDrop = chestRarityFromDrop
for _, t in ipairs(MineTools.CHEST_TOOLS) do
	local rar = MineTools.normalizeToolRarity(t.rarity or t.rarityId) or chestRarityFromDrop(t.drop)
	local floorRank = RARITY_RANK[MineTools.CHEST_RARITY_FLOOR] or 3
	if (RARITY_RANK[rar] or 0) < floorRank then
		rar = MineTools.CHEST_RARITY_FLOOR
	end
	t.rarity = rar
	t.rarityId = rar
	t.drop = MineTools.TOOL_RARITY_FIND[rar] or t.drop
	local def = MineTools.TOOL_RARITY_DEF[rar]
	if def and (not t.blurb or t.blurb == "") then
		t.blurb = def.blurb
	end
end

