--[[
	How many grid cells a blast of this radius destroys: every integer cell
	within Euclidean distance r. 0 -> 1, 1 -> 7, 2 -> 33.

	This has to be the same number the server breaks, or the balance is a
	fiction. It grows cubically, which is why the explosive ladder stops at 2.
]]
local BLAST_CELLS = { [0] = 1 }
function MineTools.blastCells(r)
	r = math.floor(math.max(0, r or 0))
	if BLAST_CELLS[r] then
		return BLAST_CELLS[r]
	end
	local n = 0
	for x = -r, r do
		for y = -r, r do
			for z = -r, r do
				if x * x + y * y + z * z <= r * r then
					n += 1
				end
			end
		end
	end
	BLAST_CELLS[r] = n
	return n
end

--[[
	Cells in a flat disc on the wall face.

	A splash loses a whole dimension against a sphere, so its radius is widened
	by 1.6 to cover the same ground: r1 -> 9 cells, r2 -> 33. MinePatterns uses
	the identical figure, which is the only reason the shop's number and the
	number the rock sees are the same number.
]]
local DISC_CELLS = {}
function MineTools.discCells(r)
	r = math.max(0, r or 0) * 1.6
	local key = string.format("%.2f", r)
	if DISC_CELLS[key] then
		return DISC_CELLS[key]
	end
	local span = math.floor(r)
	local n = 0
	for a = -span, span do
		for b = -span, span do
			if a * a + b * b <= r * r then
				n += 1
			end
		end
	end
	DISC_CELLS[key] = n
	return n
end

--[[
	How many cells one use of this tool touches.

	Pickaxes hit one. Drills hit their footprint. Explosives hit bombs x the
	pattern's cell count -- which for a line is its depth, and for everything
	else is the sphere.
]]
function MineTools.cellsOf(tool)
	if not tool then
		return 1
	end
	if tool.pattern == "line" then
		return (tool.depth or 1) * (tool.bombs or 1)
	end
	if tool.pattern == "linesplash" then
		return (tool.depth or 1) + MineTools.discCells(tool.radius or 0)
	end
	if tool.pattern == "splash" then
		return MineTools.discCells(tool.radius or 0)
	end
	if tool.bombs then
		return MineTools.blastCells(tool.radius or 0) * tool.bombs
	end
	return tool.cells or 1
end

--[[
	Shop/chest bombs used to inherit full pick power on EVERY cell of a
	~37-cell splash (~40x a pick). Cap total blast budget at ~3x a same-rung
	pick and split that across the footprint. Price still uses pre-tune power.
]]
-- A tuned charge's damage budget per throw, in pick-hits of its own rung.
-- Cap at 4× so shelf (≤4× top-pick DPS) is the real ceiling, not a 6× floor.
MineTools.EXPLOSIVE_VS_PICK = 4

--[[
	How much of a blast the rock actually takes, in full-power cells.

	MinePatterns hits the centre at full power and falls off toward the rim
	(1 - 0.6 d/r, never under 0.4), so a radius-1 splash is 9 cells but only
	~4.4 cells' worth of damage -- 5.4 on a wall, 3.4 when you throw it at the
	floor, averaged here. Dividing a charge's budget by the raw cell count
	(which is what tuneExplosive used to do) left every tuned charge landing
	about half the damage it was priced for. Mirrors MinePatterns.resolve,
	which lives on the server and cannot be required from here.
]]
local function blastFalloff(d, r)
	if not r or r <= 0 then
		return 1
	end
	return math.clamp(1 - 0.6 * (d / r), 0.4, 1)
end
local function sphereWeight(r)
	local w = 0
	for x = -r, r do
		for y = -r, r do
			for z = -r, r do
				local d2 = x * x + y * y + z * z
				if d2 <= r * r then
					w += blastFalloff(math.sqrt(d2), r)
				end
			end
		end
	end
	return w
end
local function discWeight(r)
	local w = 0
	local span = math.floor(r)
	for a = -span, span do
		for b = -span, span do
			local d2 = a * a + b * b
			if d2 <= r * r then
				w += blastFalloff(math.sqrt(d2), r)
			end
		end
	end
	return w
end
local function lineWeight(depth)
	local w = 0
	depth = math.max(1, math.floor(depth or 1))
	for i = 0, depth - 1 do
		w += math.clamp(1 - 0.5 * (i / math.max(1, depth - 1)), 0.5, 1)
	end
	return w
end
function MineTools.patternWeight(tool)
	if not tool then
		return 1
	end
	local r = math.floor(tool.radius or 0)
	local pattern = tool.pattern
	if pattern == "splash" then
		return (discWeight(math.max(1.2, r * 1.6)) + sphereWeight(math.max(1, r))) / 2
	elseif pattern == "sphere" or pattern == "blackhole" then
		return sphereWeight(r)
	elseif pattern == "cluster" then
		return (tool.bombs or 1) * sphereWeight(r)
	elseif pattern == "line" then
		return lineWeight(tool.depth) * (tool.bombs or 1)
	elseif pattern == "linesplash" then
		return lineWeight(tool.depth) + discWeight(r * 1.6)
	end
	return math.max(1, MineTools.cellsOf(tool))
end

function MineTools.tuneExplosive(tool, pickPower)
	if not tool or tool.family ~= "explosive" then
		return tool
	end
	pickPower = math.max(1, tonumber(pickPower) or tonumber(tool.power) or 1)
	local cells = math.max(1, MineTools.cellsOf(tool))
	tool.cells = cells
	local mult = MineTools.EXPLOSIVE_VS_PICK or 3
	-- Budget over what actually lands (falloff included), not the cell count.
	tool.power = math.max(1, math.floor(pickPower * mult / math.max(1, MineTools.patternWeight(tool)) + 0.5))
	return tool
end

--[[
	The budget a tool spends per second, before the per-block HP cap.

	Drills: power x footprint x rate. Explosives: power x bombs x cells, divided
	by the cooldown. Pickaxes: power x rate. Quote this against price and the
	ladder should climb without a single rung costing more for less.
]]
function MineTools.budget(tool)
	if not tool then
		return 0
	end
	local cells = MineTools.cellsOf(tool)
	if tool.cooldown then
		return (tool.power or 1) * cells / math.max(0.05, tool.cooldown)
	end
	return (tool.power or 1) * cells * (tool.rate or 1)
end

--[[
	Blocks-per-second against a given block HP.

	`turnFreq` is the fraction of blocks that need a direction change: 0 is a
	straight shaft down, 0.5 is weaving after a vein. This is the whole point of
	the drill family -- ignore it and a Shaftbreaker reads as eight times a top
	pickaxe, which is not the trade being offered. Always quote both ends.
]]
function MineTools.throughput(tool, blockHp, boosts, turnFreq)
	boosts = boosts or {}
	turnFreq = turnFreq or 0
	local power = (tool.power or 1) * (1 + (boosts.mineSpeed or 0))
	local rate = (tool.rate or 1) * (1 + (boosts.swingRate or 0))
	local swings = math.max(1, math.ceil(blockHp / math.max(0.01, power)))
	local perBlock = swings / rate
	if tool.cooldown then
		perBlock += tool.cooldown
	end
	-- Spin-up on every direction change.
	if tool.turn and tool.turn > 0 then
		perBlock += tool.turn * turnFreq
	end
	return MineTools.cellsOf(tool) / perBlock
end

--[[
	Coin-shop tiers are zone-gated so a pile of coins cannot skip the specials.
	Pickaxe T1-25: ceil(tier/5). Drill/explosive T1-16: ceil(tier/3).
]]
function MineTools.minZone(familyId, tier)
	tier = math.max(1, tonumber(tier) or 1)
	-- Spread the full ladders across all 10 islands.
	if familyId == "pickaxe" then
		return math.clamp(math.ceil(tier / 2.5), 1, 10)
	end
	if familyId == "drill" or familyId == "explosive" then
		return math.clamp(math.ceil(tier / 1.5), 1, 10)
	end
	return 1
end

--------------------------------------------------------------------------------
-- LETTING A TOOL GO
--
-- Two different objects, two different answers.
--
-- A LADDER tool was bought off a shelf with coins. It is a rung, not a keepsake:
-- the one above it does everything it did. Selling hands back a share of the
-- coins, and only the TOP rung you own can go -- owning tier 9 is what makes
-- tiers 1-8 yours, so there is no pulling one out of the middle.
--
-- A FOREVER tool came out of a chest, an event or the pass. Never
-- from a pack open. There is
-- no shelf to refund against, so it pays in the two things coins cannot buy:
-- stardust for the tool, temper tokens for its rarity. Both price themselves off
-- MineTools.budget -- the number the game already uses for "how good is this" --
-- so a tool added next month quotes a sane number without anyone tuning it.
--
-- Deliberately a bad deal in both directions. This is a way to clear a bag you
-- are done with, not an income.
--------------------------------------------------------------------------------
MineTools.LADDER_SELL_SHARE = 0.30
MineTools.FOREVER_TOKENS = {
	Common = 0, Uncommon = 1, Rare = 1, Epic = 2,
	Legendary = 3, Mythic = 5, Divine = 8, Exotic = 12,
}

-- Coins back on a shop-bought rung. 0 means "not for sale" -- the starter tool
-- is priced at 0 and you are not allowed to end up with nothing in your hands.
function MineTools.ladderSellValue(def)
	local price = tonumber(def and def.price) or 0
	if price <= 0 then
		return 0
	end
	return math.max(1, math.floor(price * MineTools.LADDER_SELL_SHARE))
end

--[[
	Stardust and temper tokens for a forever tool. Returns both.

	The square root matters: raw budget spans five orders of magnitude across the
	table, and paying that straight would make one Worldbreaker worth more
	stardust than a season of scrapping. Rooted, the best tool in the game pays
	about twenty-five times the worst instead of ten thousand times.
]]
function MineTools.foreverSellValue(def, owned)
	if not def then
		return 0, 0
	end
	local budget = MineTools.budget(def)
	-- Stardust scales with power; tokens scale harder so flagships fund cases / skill buyback.
	local dust = math.max(25, math.floor(40 * math.sqrt(math.max(1, budget))))
	local rarity = tostring((owned and owned.rarity) or def.rarity or def.rarityId or "Common")
	local floorTok = MineTools.FOREVER_TOKENS[rarity] or 0
	-- Lunar (budget ~30.8 at power 11) lands ~150 tokens; stronger tools climb fast.
	local tokens = math.max(floorTok, math.floor(4.85 * math.max(1, budget) + 0.5))
	local shadow = (owned and owned.shadow) or def.shadow
	local shiny = (owned and owned.shiny) or def.shiny
	if shadow then
		dust = math.floor(dust * 2)
		tokens = math.floor(tokens * 1.35)
	elseif shiny then
		dust = math.floor(dust * 1.5)
		tokens = math.floor(tokens * 1.15)
	end
	return dust, tokens
end

-- Ladder/chest pick combat ~25% under list power; shop prices use economy raw.
MineTools.PICK_COMBAT_MULT = 0.75
do
	local mult = MineTools.PICK_COMBAT_MULT
	for _, t in ipairs(MineTools.TOOLS.pickaxe or {}) do
		if type(t) == "table" and t.power then
			t.power = math.max(1, math.floor(t.power * mult + 0.5))
		end
	end
end

--[[
	The "1 in X" a player is shown for a chest tool: the chance of THAT tool, in
	THAT finish, from THAT one chest -- with the luck that rolled it. Mirrors
	rollChestTool (drop x luck) and rollFinish above, including Nightmare only
	existing shallower than NIGHTMARE_MAX_LAYER, so the number on screen is true.
	oneInOf above is the luck-free catalogue figure.
]]
function MineTools.exactOneIn(drop, luck, shiny, shadow, nightmare, layer)
	local s = MineTools.SHINY_CHANCE or 0.04
	local sh = MineTools.SHADOW_OF_SHINY or 0.05
	local under = tonumber(layer) and tonumber(layer) < (MineTools.NIGHTMARE_MAX_LAYER or 2500)
	local nm = under and (MineTools.NIGHTMARE_OF_SHADOW or 0.05) or 0
	local finish
	if nightmare then
		finish = s * sh * nm
	elseif shadow then
		finish = s * sh * (1 - nm)
	elseif shiny then
		finish = s * (1 - sh)
	else
		finish = 1 - s
	end
	local p = math.min(1, math.max(0, tonumber(drop) or 0) * math.max(0, tonumber(luck) or 1)) * finish
	if p <= 0 then
		return nil
	end
	return math.max(1, math.floor(1 / p + 0.5))
end

--[[
	SHARED MODULE -- it cannot reach into ServerStorage.

	This block is written by the tool-rename pass. Its original form was
	require(game.ServerStorage:WaitForChild("ApplyToolRename")), and
	ServerStorage never replicates: on the CLIENT that WaitForChild never
	returns, the require never finishes, and every script that required
	this module -- MineClient included -- stopped dead on that line. No
	HUD, no panels, nothing. The server was unaffected, which is what made
	it look like a UI bug instead of a require that never came back.

	Same rename, same effect, resolved from the copy already sitting in
	Shared. FindFirstChild does not yield, so the worst case is the rename
	is skipped -- not the game failing to start.

	IF THE RENAME PASS REWRITES THIS FILE IT WILL PUT THE OLD LINE BACK.
	The generator needs to emit this form too.
]]
do
	local src = script.Parent:FindFirstChild("ApplyToolRename")
		or game:GetService("ServerStorage"):FindFirstChild("ApplyToolRename")
	if src then
		pcall(function()
			require(src).apply(MineTools)
		end)
	end
end
return MineTools
