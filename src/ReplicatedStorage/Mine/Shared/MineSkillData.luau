--------------------------------------------------------------------------------
-- FORMULAS
--------------------------------------------------------------------------------

local byId = {}
for _, n in ipairs(MineSkillData.NODES) do
	byId[n.id] = n
end
function MineSkillData.node(id)
	return byId[id]
end

-- PRICING has three multipliers stacked on it, and each one exists for a
-- reason:
--
--   1. DEPTH   -- baked into `costs` via the row's `eff`. A keystone rank costs
--                 more than a root rank, but delivers more points per token, so
--                 going deep is the efficient play.
--   2. RANK    -- each further rank of the SAME node costs RANK_STEP more, which
--                 pushes you to widen your road instead of dumping everything
--                 into one node.
--   3. BREADTH -- everything you already own makes everything still unbought
--                 dearer. This is what stops a late-game player from simply
--                 owning the whole wheel.
--
-- Note the honest cost of multiplier 3: because it reads live state, buying
-- expensive nodes FIRST is marginally cheaper than buying them last. The
-- coefficients are deliberately small so that edge is a rounding error rather
-- than a strategy, but it is real and it is the price of the mechanic.
MineSkillData.OWNED_STEP = 0.05
MineSkillData.LEVEL_STEP = 0.015

function MineSkillData.inflation(state)
	local owned, levels = 0, 0
	for _, level in pairs((state and state.levels) or {}) do
		if level > 0 then
			owned += 1
			levels += level
		end
	end
	return 1 + MineSkillData.OWNED_STEP * owned + MineSkillData.LEVEL_STEP * levels
end

-- Base cost of taking a node from `level` to `level + 1`, before breadth.
function MineSkillData.baseCost(id, level)
	local n = byId[id]
	if not n then
		return nil
	end
	local rank = (level or 0) + 1
	if rank > n.maxLevel then
		return nil
	end
	return n.costs[rank]
end

-- What it actually costs this player right now.
function MineSkillData.nextCost(id, level, state)
	local base = MineSkillData.baseCost(id, level)
	if not base then
		return nil
	end
	if not state then
		return base
	end
	return math.ceil(base * MineSkillData.inflation(state))
end

-- Total skill points sunk into a node at `level`.
function MineSkillData.spentOn(id, level)
	local n = byId[id]
	local t = 0
	for r = 1, math.min(level or 0, n and n.maxLevel or 0) do
		t += n.costs[r]
	end
	return t
end

-- The node's stat table at a given level (linear in level: rank N gives N times
-- one rank's worth).
function MineSkillData.statsAt(id, level)
	local n = byId[id]
	local out = {}
	if not n or (level or 0) <= 0 then
		return out
	end
	for stat, amount in pairs(n.stats) do
		out[stat] = amount * level
	end
	return out
end

--------------------------------------------------------------------------------
-- STATE
--
-- `state` is { levels = { [nodeId] = level }, tokens = n, spent = n }.
-- Everything below is pure, so the server can run the same checks the client
-- shows and neither can drift.
--------------------------------------------------------------------------------

local function levelOf(state, id)
	return (state and state.levels and state.levels[id]) or 0
end
MineSkillData.levelOf = levelOf

-- Is every prerequisite satisfied? "and" needs all of them owned, "or" needs
-- one -- that OR is what lets a keystone be reached down either road.
function MineSkillData.prereqsMet(state, id)
	local n = byId[id]
	if not n or #n.prereqs == 0 then
		return true
	end
	if n.prereqMode == "or" then
		for _, p in ipairs(n.prereqs) do
			if levelOf(state, p) > 0 then
				return true
			end
		end
		return false
	end
	for _, p in ipairs(n.prereqs) do
		if levelOf(state, p) <= 0 then
			return false
		end
	end
	return true
end

-- What is blocking this node, if anything. Returns nil when it is takeable.
function MineSkillData.blockedBy(state, id)
	local n = byId[id]
	if not n then
		return "no such node"
	end
	if n.xorGroup then
		for _, other in ipairs(MineSkillData.NODES) do
			if other.xorGroup == n.xorGroup and other.id ~= n.id and levelOf(state, other.id) > 0 then
				return "road", other
			end
		end
	end
	if n.rivalOf and levelOf(state, n.rivalOf) > 0 then
		return "rival", byId[n.rivalOf]
	end
	if not MineSkillData.prereqsMet(state, id) then
		return "prereq", nil
	end
	return nil
end

function MineSkillData.canBuy(state, id)
	local n = byId[id]
	if not n then
		return false, "no such node"
	end
	local level = levelOf(state, id)
	if level >= n.maxLevel then
		return false, "maxed"
	end
	local why, other = MineSkillData.blockedBy(state, id)
	if why then
		return false, why, other
	end
	local cost = MineSkillData.nextCost(id, level, state)
	if cost > (state.tokens or 0) then
		return false, "tokens"
	end
	return true, nil, nil, cost
end

-- Every stat the build currently grants, summed. No magnitude cap.
-- Pass the MineStats module in so this file does not have to know where it
-- lives.
function MineSkillData.totalStats(state, Stats)
	local out = {}
	for id, level in pairs((state and state.levels) or {}) do
		for stat, amount in pairs(MineSkillData.statsAt(id, level)) do
			out[stat] = (out[stat] or 0) + amount
		end
	end
	local auto = out.autoMine
	if auto and auto ~= 0 then
		local ratio = (Stats and Stats.AUTO_MINE_TO_GEM) or (2.5 / 1.8)
		out.gemFind = (out.gemFind or 0) + auto * ratio
		out.autoMine = nil
	end
	return out
end

function MineSkillData.totalSpent(state)
	local t = 0
	for id, level in pairs((state and state.levels) or {}) do
		t += MineSkillData.spentOn(id, level)
	end
	return t
end

--[[
	Points to buy every level of every node.

	Skill points are purchasable with tokens now (Verbs.skillBuyBack), and the
	only limit the design puts on that is that there has to be something left to
	spend them on -- so something has to know what "maxed" costs. It is 1,355
	against the 460 that forty rebirths grant, which is what keeps the tree a
	long-term sink for recycled flagships rather than a checklist.

	Cached: the node table never changes at runtime.
]]
local maxTreeCache
function MineSkillData.maxTreePoints()
	if maxTreeCache then
		return maxTreeCache
	end
	local total = 0
	for _, node in pairs(MineSkillData.NODES) do
		if type(node) == "table" and node.id then
			total += tonumber(MineSkillData.spentOn(node.id, tonumber(node.maxLevel) or 1)) or 0
		end
	end
	maxTreeCache = total
	return total
end

function MineSkillData.ownedCount(state)
	local n = 0
	for _, level in pairs((state and state.levels) or {}) do
		if level > 0 then
			n += 1
		end
	end
	return n
end

--------------------------------------------------------------------------------
-- REBIRTH
--
-- The ratio DECAYS: early rebirths are quick hits, later ones settle onto a
-- steady climb that tracks how fast income actually grows in zone 6. A flat
-- geometric ratio either makes rebirth 3 a wall or rebirth 30 free.
--------------------------------------------------------------------------------

-- 2026-09-19: 2400 -> 7500. At 2400 the first rebirth was about five minutes
-- of a new player's mining; every rank costs ~3x the coins now.
MineSkillData.REBIRTH_BASE = 7500
MineSkillData.RATIO_FLOOR = 1.55
MineSkillData.RATIO_HEAD = 1.1
MineSkillData.RATIO_DECAY = 0.72

function MineSkillData.rebirthRatio(n)
	return MineSkillData.RATIO_FLOOR + MineSkillData.RATIO_HEAD * (MineSkillData.RATIO_DECAY ^ ((n or 1) - 1))
end

--[[
	Coins needed to perform rebirth number `n`.

	Flat 2.08 growth from a simulated base. An earlier curve compounded a
	per-step ratio starting at 2.65, which outran the income the rebirth
	unlocked and made rebirth 2 take LONGER than rebirth 1.

	THIS ONLY HOLDS WHILE ZONES KEEP UNLOCKING. Each rebirth up to the last
	zone gate opens a zone whose blocks pay substantially more, and that is what
	pays for a doubling. Past the final zone the only income growth left is
	prestigeYield -- 1 + 0.15 * R -- which lifts income about 1.5x over six
	rebirths while this curve lifts cost 81x. At six zones that wall stood at
	rebirth 6.

	So the zone count has to keep pace with the rebirth count. If zones stop
	being added, this curve needs a knee at the last gate instead.
]]
function MineSkillData.rebirthCost(n)
	local c = MineSkillData.REBIRTH_BASE * math.pow(2.08, math.max(0, (n or 1) - 1))
	local mag = 10 ^ math.max(0, math.floor(math.log10(c)) - 2)
	return math.round(c / mag) * mag
end

local function roundMoney(c)
	c = math.max(0, tonumber(c) or 0)
	if c < 10 then
		return math.round(c)
	end
	local mag = 10 ^ math.max(0, math.floor(math.log10(c)) - 2)
	return math.round(c / mag) * mag
end

--[[
	Minimum coin bank before rebirth is *recommended*.

	The pay wall (rebirthCost) is what the button charges. The minimum is that
	cost times rebirthRatio(n) so you start the next run with breathing room for
	pickaxe buys instead of rebirthing the instant you can afford the fee.

	Early ranks want more headroom (~2.65x at R1); the ratio decays toward
	RATIO_FLOOR (1.55x) as ranks climb.
]]
function MineSkillData.minRebirthCoins(n)
	return roundMoney(MineSkillData.rebirthCost(n) * MineSkillData.rebirthRatio(n))
end

--[[
	Advice blob for UI / snap. Never hard-blocks rebirth — only guides.
]]
function MineSkillData.rebirthAdvice(coins, prestige, zone)
	local nextR = (math.max(0, math.floor(tonumber(prestige) or 0))) + 1
	local cost = MineSkillData.rebirthCost(nextR)
	local minCoins = MineSkillData.minRebirthCoins(nextR)
	local have = math.floor(tonumber(coins) or 0)
	local canAfford = have >= cost
	local recommended = have >= minCoins
	local status, reason
	if recommended then
		status = "ready"
		reason = string.format(
			"Minimum bank hit (%s). Rebirth for skill points + temper tokens.",
			tostring(minCoins))
	elseif canAfford then
		status = "early"
		reason = string.format(
			"You can pay the %s fee, but farm to %s first so the next run isn't starved.",
			tostring(cost), tostring(minCoins))
	else
		status = "farm"
		reason = string.format(
			"Farm to %s coins (pay wall %s). Gems/cards/runes/gear/skills keep.",
			tostring(minCoins), tostring(cost))
	end
	return {
		nextR = nextR,
		cost = cost,
		minCoins = minCoins,
		ratio = MineSkillData.rebirthRatio(nextR),
		have = have,
		canAfford = canAfford,
		recommended = recommended,
		status = status,
		reason = reason,
		skillPoints = MineSkillData.tokensFor(nextR),
		temperTokens = MineSkillData.rebirthTokens(nextR),
		gems = MineSkillData.rebirthGemReward(nextR, zone),
	}
end

-- A few gems for every rebirth: 150 at the first, +50 each after, scaled by
-- the deepest zone owned the way the dailies are.
function MineSkillData.rebirthGemReward(n, zone)
	n = math.max(1, math.floor(tonumber(n) or 1))
	local z = math.max(1, math.floor(tonumber(zone) or 1))
	return math.floor((150 + 50 * (n - 1)) * (1 + 0.6 * (z - 1)))
end

-- Skill points granted by rebirth number `n`.
-- Shape stays: grows slowly with n. Do NOT ×10 this grant unless skill node
-- costs are also ×10 — keep temperament economy on the named constants below.
function MineSkillData.tokensFor(n)
	return 2 + math.floor(((n or 1) - 1) / 2)
end

--[[
	SKILL POINTS AND TOKENS.

	Two currencies, and they only touch in two places:

	  skill points  come from rebirths. They buy nodes. A node comes back out
	                through Reset in the Clouds, refunded from `spent` -- the
	                amount actually paid, so it is exact.
	  tokens        come from rebirths too, and from selling skill points.
	                They roll temperaments, and they buy sold points back.

	  sell 1 skill point      -> +UNUSED_SKILL_POINT_SELL tokens
	  buy 1 skill point back  -> -UNUSED_SKILL_POINT_SELL tokens, only for a point
	                             you sold: you can never hold more skill points than
	                             your rebirths have given you
	  temperament roll        -> -TEMPER_ROLL_COST tokens, and nothing refunds it
	  rebirth n               -> +tokensFor(n) skill points
	                             +rebirthTokens(n) tokens

	Selling and buying back at the same price is what makes a sale safe to try:
	the only thing that is ever permanently gone is what you rolled with.

	Rolls used to charge the active preset's `spent`, the same field a skill
	node charges -- so Reset handed every roll straight back, and a player could
	reroll a temperament forever for free. Rolls touch tokens and nothing else.
]]
MineSkillData.UNUSED_SKILL_POINT_SELL = 30
MineSkillData.BUYBACK_TOKENS = MineSkillData.UNUSED_SKILL_POINT_SELL
-- Flat. The old curve, min(8, 1 + floor(rolls / 2)), is deliberately not used.
MineSkillData.TEMPER_ROLL_COST = 20

--[[
	Tokens granted by rebirth number `n`: that rebirth's skill points, priced at
	the sell rate -- enough to buy back every point it gave you. A player who
	never sells spends them on rolls; one who sold points to roll can win them
	back at the next rebirth.
]]
function MineSkillData.rebirthTokens(n)
	return MineSkillData.tokensFor(n) * MineSkillData.UNUSED_SKILL_POINT_SELL
end

function MineSkillData.tokensThrough(n)
	local t = 0
	for i = 1, (n or 0) do
		t += MineSkillData.tokensFor(i)
	end
	return t
end

--------------------------------------------------------------------------------
-- PRESETS  ("In the Clouds")
--
-- The tree changes in the Clouds and nowhere else: buying, resetting,
-- sacrificing and swapping presets all happen on the cloud deck. The Clouds is
-- a PLACE you can always go back to, not a window that closes on your first
-- block -- that version locked every point a player earned the moment they
-- started mining.
--
-- Reset deliberately does NOT cost anything. If the power currency also paid
-- for experiments, every experiment would be a permanent power loss and nobody
-- would run one -- they would copy a guide instead, and the build variety this
-- whole tree exists for would die.
--
-- There is no gamepass. "Afterbirth" (edit anywhere + presets 3-5) was declared
-- here and never sold: nothing in the game ever set it true, so slots 3-5 sat
-- behind a lock that could not be opened.
--------------------------------------------------------------------------------

MineSkillData.PRESETS = {
	max = 2,
	free = 1,
	-- The second slot is the one thing skill points buy that is not power.
	secondSlotCost = 25,
}

function MineSkillData.presetsAvailable(boughtSecond)
	return MineSkillData.PRESETS.free + (boughtSecond and 1 or 0)
end

-- True only while the player is standing in the Clouds. The caller decides
-- where that is -- MineConfig.playerInClouds on the server, the same check
-- against the local character on the client.
function MineSkillData.canEdit(inClouds)
	return inClouds == true
end

--[[
	There is no per-rank refund. One was built -- canSacrifice / peelableId --
	and it priced each rank at the CURRENT inflation rather than what was paid,
	so the same 139-rank tree refunded 2,182 points whether it had cost 2,138 or
	2,766. A player who bought cheapest-first lost 431 points using it. Reset
	refunds from `spent`, which is exact, and is the one way ranks come back.
]]

--------------------------------------------------------------------------------
-- AUDIT
--------------------------------------------------------------------------------

-- Walks every energy's road A and road B, reports the value each delivers in
-- MineStats points. All twenty should land on the same value; anything else
-- means the allocator leaked budget.
function MineSkillData.audit(Stats)
	local rows, worstSpread = {}, 0
	local lo, hi = math.huge, 0
	for _, e in ipairs(MineSkillData.ENERGIES) do
		for _, which in ipairs({ "A", "B" }) do
			local ids = { e.id .. ".root", e.id .. ".split" .. which, e.id .. ".cross" .. which, e.id .. ".key" }
			local total, points, sp = {}, 0, 0
			for _, id in ipairs(ids) do
				local n = byId[id]
				for stat, amount in pairs(n.stats) do
					total[stat] = (total[stat] or 0) + amount * n.maxLevel
				end
				points += n.points * n.maxLevel
				sp += MineSkillData.spentOn(id, n.maxLevel)
			end
			local value = Stats and Stats.valueOf(total) or 0
			lo, hi = math.min(lo, value), math.max(hi, value)
			table.insert(rows, { energy = e.name, road = which, value = value, sp = sp, points = points })
		end
	end
	worstSpread = lo > 0 and hi / lo or 0
	return rows, worstSpread
end

return MineSkillData
