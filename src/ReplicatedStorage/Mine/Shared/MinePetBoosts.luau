--[[
	MinePetBoosts -- the pet kit lookup, and how a card names itself.

	Every named pet's kit lives in ONE table: MineZonePets.KITS, generated by
	tools/gen/zone-pets.js (zone pets on the approved ladder, +5% per zone;
	Event Horizon as zone 11). It is exposed here as PET_BOOSTS.Z.

	Gone on 2026-10-10 (owner: "remove all old information"): the X and Y kit
	bags, which no pet used once every pet had a zone kit, and a second Event
	Horizon copy that disagreed with this one on 69 of 73 pets. Their generator
	(_gen_all_pet_boosts.js) was never in the repo.
]]
local M = {}

M.NAME_ALIASES = {
	["Horizon+"] = "Matter+",
	["Horizon-"] = "Matter-",
	["horizon_plus"] = "Matter+",
	["horizon_minus"] = "Matter-",
	["Albert Horizontein"] = "Albert Minestein",
	["Albert Minestine"] = "Albert Minestein",
	["Matter(+)"] = "Matter+",
	["Matter(-)"] = "Matter-",
}

M.PET_BOOSTS = {}
do
	local ok, zp = pcall(require, script.Parent:FindFirstChild("MineZonePets"))
	if ok and type(zp) == "table" and zp.KITS then
		M.PET_BOOSTS.Z = zp.KITS
	end
end

function M.resolveName(name)
	if type(name) ~= "string" then return name end
	return M.NAME_ALIASES[name] or name
end

-- The kit for a named pet, or nil (an unnamed print uses MineCards.getKit).
-- setKey is accepted for old callers and ignored: a name has one kit.
function M.boostsFor(name, _setKey)
	name = M.resolveName(name)
	if type(name) ~= "string" or name == "" then return nil end
	local z = M.PET_BOOSTS.Z
	return z and z[name] or nil
end

-- Locked EH brands keep their canonical name on the card face.
-- Everything else headlines the creature (animal) when present.
-- Kit lookup still uses the stable pet name / aliases (no renames).
M.LOCKED_DISPLAY = {
	["Matter+"] = true,
	["Matter-"] = true,
	Cosmo = true,
	["Albert Minestein"] = true,
}

function M.displayName(card)
	if type(card) ~= "table" then
		return tostring(card or "Pet")
	end
	local name = M.resolveName(card.name)
	if M.LOCKED_DISPLAY[name] then
		return name
	end
	local animal = card.animal or card.animalName
	if type(animal) == "string" and animal ~= "" then
		return animal
	end
	return name or "Pet"
end

function M.subtitleName(card)
	if type(card) ~= "table" then
		return nil
	end
	local name = M.resolveName(card.name)
	local title = M.displayName(card)
	if title ~= name then
		return name
	end
	return nil
end

return M
