--[[
	ZONE KITS (MineZonePets.KITS): the kit of every regular pet since the zone
	pots (2026-10-10). On the approved ladder (docs/PROPOSAL.md §0 line 3), +5%
	per zone. They outrank X and Y, which the owner calls old; those bags stay
	only so nothing that still reads them breaks.
]]
do
	local ok, zp = pcall(require, script.Parent:FindFirstChild("MineZonePets"))
	if ok and type(zp) == "table" and zp.KITS then
		M.PET_BOOSTS.Z = zp.KITS
	end
end

function M.resolveName(name)
	if type(name) ~= "string" then return name end
	return M.NAME_ALIASES[name] or name
end

function M.boostsFor(name, setKey)
	name = M.resolveName(name)
	if type(name) ~= "string" or name == "" then return nil end
	local bags = M.PET_BOOSTS or {}
	local ehSets = { genesis_spark = true, first_light = true, proto_ore = true, EH = true, bigbang = true }
	if setKey and ehSets[setKey] and bags.EH and bags.EH[name] then
		return bags.EH[name]
	end
	if bags.Z and bags.Z[name] then
		return bags.Z[name]
	end
	if setKey and bags[setKey] and bags[setKey][name] then
		return bags[setKey][name]
	end
	if bags.EH and bags.EH[name] then return bags.EH[name] end
	if bags.X and bags.X[name] then return bags.X[name] end
	if bags.Y and bags.Y[name] then return bags.Y[name] end
	return nil
end

-- Locked EH brands keep their canonical name on the card face.
-- Everything else headlines the creature (animal) when present.
-- Kit lookup still uses the stable pet name / aliases (no renames).
M.LOCKED_DISPLAY = {
	["Matter+"] = true,
	["Matter-"] = true,
	Cosmo = true,
	["Albert Minestein"] = true,
}

function M.displayName(card)
	if type(card) ~= "table" then
		return tostring(card or "Pet")
	end
	local name = M.resolveName(card.name)
	if M.LOCKED_DISPLAY[name] then
		return name
	end
	local animal = card.animal or card.animalName
	if type(animal) == "string" and animal ~= "" then
		return animal
	end
	return name or "Pet"
end

function M.subtitleName(card)
	if type(card) ~= "table" then
		return nil
	end
	local name = M.resolveName(card.name)
	local title = M.displayName(card)
	if title ~= name then
		return name
	end
	return nil
end

return M
