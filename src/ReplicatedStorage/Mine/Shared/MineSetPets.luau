--[[
	MineSetPets -- the 19 exclusive sets' pets, gathered from SetPets/<Set>.

	Owner, 2026-10-10: 19 sets graded F to SSS, every pet named, each set's pets
	5% better than the set before (set 1 at zone 1's level). The data modules
	under SetPets/ are GENERATED by tools/gen/set-pets.js; this file only
	gathers them, in the owner's order.

	What reads this:
	  MinePetRoster   merges PETS into the roster and stamps every pet's set
	  MinePetBoosts   KITS join the one kit table (PET_BOOSTS.Z)
	  PetModelFactory ANIMALS adds the set pets' skins (never overwrites one)
]]
local M = {}

M.SETS = {} -- in the owner's order (INDEX 1..19)
-- Holiday packs' pet lists (HolidayPets/, tools/gen/holiday-pets.js). NOT in
-- SETS: no set pack, case or shop walks them. Their pets join PETS, ANIMALS,
-- KITS, ROLE and SET_OF like any set's, each row stamped `holiday`.
M.HOLIDAY_SETS = {}
-- An older holiday pet a holiday pack also pays: name -> that pack's key.
M.LEGACY_SET = {}
M.BY_KEY = {}
M.PETS = {}
M.ANIMALS = {}
M.KITS = {}
M.ROLE = {}
M.SET_OF = {}

local folder = script.Parent:FindFirstChild("SetPets")
if folder then
	local loaded = {}
	for _, mod in ipairs(folder:GetChildren()) do
		if mod:IsA("ModuleScript") then
			local ok, set = pcall(require, mod)
			if ok and type(set) == "table" and set.KEY then
				table.insert(loaded, set)
			else
				warn("[MineSetPets] SetPets/" .. mod.Name .. ": " .. tostring(set))
			end
		end
	end
	table.sort(loaded, function(a, b)
		return (a.INDEX or 99) < (b.INDEX or 99)
	end)
	for _, set in ipairs(loaded) do
		table.insert(M.SETS, set)
		M.BY_KEY[set.KEY] = set
		for _, row in ipairs(set.PETS or {}) do
			table.insert(M.PETS, row)
			M.SET_OF[row.name] = set.KEY
		end
		for animal, skin in pairs(set.ANIMALS or {}) do
			M.ANIMALS[animal] = skin
		end
		for name, kit in pairs(set.KITS or {}) do
			M.KITS[name] = kit
		end
		for name, role in pairs(set.ROLE or {}) do
			M.ROLE[name] = role
		end
	end
end

do
	local holiday = script.Parent:FindFirstChild("HolidayPets")
	if holiday then
		for _, mod in ipairs(holiday:GetChildren()) do
			if mod:IsA("ModuleScript") then
				local ok, set = pcall(require, mod)
				if ok and type(set) == "table" and set.KEY then
					table.insert(M.HOLIDAY_SETS, set)
					M.BY_KEY[set.KEY] = set
					for _, row in ipairs(set.PETS or {}) do
						table.insert(M.PETS, row)
						M.SET_OF[row.name] = set.KEY
					end
					for animal, skin in pairs(set.ANIMALS or {}) do
						M.ANIMALS[animal] = skin
					end
					for name, kit in pairs(set.KITS or {}) do
						M.KITS[name] = kit
					end
					for name, role in pairs(set.ROLE or {}) do
						M.ROLE[name] = role
					end
					for _, name in ipairs(set.LEGACY or {}) do
						M.LEGACY_SET[name] = set.KEY
					end
				else
					warn("[MineSetPets] HolidayPets/" .. mod.Name .. ": " .. tostring(set))
				end
			end
		end
		table.sort(M.HOLIDAY_SETS, function(a, b)
			return a.KEY < b.KEY
		end)
	end
end

-- The set a pet belongs to (its key), or nil.
function M.setOf(name)
	return M.SET_OF[name]
end

-- 1 for Pebblebound .. 19 for Chaos Theory.
function M.setIndex(key)
	local set = M.BY_KEY[key]
	return set and set.INDEX or nil
end

-- A set's power over set 1 (and zone 1): 1.05 per set.
function M.setMult(key)
	local set = M.BY_KEY[key]
	return set and set.POWER or 1
end

return M
