function MineToolIcons.resolve(name)
	if type(name) ~= "string" or name == "" then
		return nil
	end
	local e = MineToolIcons.MAP[name]
	if not e then
		return nil
	end
	local img = MineToolIcons.SHEETS[e.sheet]
	if not img then
		return nil
	end
	return {
		image = img,
		rectOffset = Vector2.new(e.ox, e.oy),
		rectSize = Vector2.new(MineToolIcons.CELL, MineToolIcons.CELL),
	}
end

function MineToolIcons.apply(imageLabel, name)
	local r = MineToolIcons.resolve(name)
	if not r then
		return false
	end
	imageLabel.Image = r.image
	imageLabel.ImageRectOffset = r.rectOffset
	imageLabel.ImageRectSize = r.rectSize
	return true
end

return MineToolIcons
